# Copy to .env.local and supply your own key. Never commit .env.local.
OPENAI_API_KEY=
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-6-luna
AGENT_MAX_TURNS=30
AGENT_TIMEOUT_MS=300000

# For AGENT_PROVIDER=meta, set AGENT_MODEL to a Meta model ID and supply:
# Example model: muse-spark-1.3 (Standard mode).
META_API_KEY=

# For AGENT_PROVIDER=gemini, set its model ID in AGENT_MODEL and supply:
GOOGLE_GENERATIVE_AI_API_KEY=

# For AGENT_PROVIDER=claude, set its model ID in AGENT_MODEL and supply:
ANTHROPIC_API_KEY=

# For AGENT_PROVIDER=openai-compatible, use a tool-capable Chat Completions API:
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

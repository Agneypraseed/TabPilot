# Add one or more provider keys. The model picker appears in the Chrome panel.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: preserve Jev through Vercel AI Gateway.
AI_GATEWAY_API_KEY=

{
  "manifest_version": 3,
  "name": "TabPilot",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Gives LLM computer use on Browser",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  }
}

{
  "manifest_version": 3,
  "name": "TabPilot",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "description": "Gives LLM computer use on Browser",
  "action": {
    "default_title": "Open TabPilot",
    "default_popup": "sidepanel.html?popup=1"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": [
    "storage",
    "debugger",
    "tabs",
    "sidePanel",
    "notifications",
    "offscreen"
  ],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  }
}

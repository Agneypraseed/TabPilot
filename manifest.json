{
  "manifest_version": 3,
  "name": "TabPilot",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "description": "Gives LLM computer use on Browser",
  "action": {
    "default_title": "Open TabPilot",
    "default_popup": "sidepanel.html?popup=1"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "debugger",
    "tabs",
    "downloads",
    "sidePanel",
    "notifications",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://api.openai.com/*",
    "https://api.meta.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.telegram.org/*",
    "https://api.resend.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
